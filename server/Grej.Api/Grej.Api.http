@apiUrl = http://localhost:5200

GET {{apiUrl}}/api/health
Accept: application/json

###

POST {{apiUrl}}/api/checkout
Content-Type: application/json

{
  "items": [{ "productId": 1, "quantity": 1 }]
}

###

POST {{apiUrl}}/api/checkout
Content-Type: application/json

{
  "items": [{ "productId": 1, "quantity": 1 }, { "productId": 1, "quantity": 1 }]
}

###

# REST Client asks for the email and password when sending, so they are never saved here.
# @name login
# @prompt email
# @prompt password
POST {{apiUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

###

# Send the login request above first. Its token is used here.
GET {{apiUrl}}/api/auth/me
Authorization: Bearer {{login.response.body.token}}

###

# Without a token the API answers 401.
GET {{apiUrl}}/api/auth/me

###

# The CMS's products, hidden ones too. Send the login request above first.
GET {{apiUrl}}/api/admin/products
Authorization: Bearer {{login.response.body.token}}

###

# Creates a hidden test product. The database is shared with production,
# so delete it with the DELETE request below when you are done.
# @name created
POST {{apiUrl}}/api/admin/products
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "title": "Testprodukt från REST Client",
  "description": "",
  "price": 100,
  "stock": 1,
  "isActive": false
}

###

# Price 0 breaks the rules: 400, and nothing is saved.
POST {{apiUrl}}/api/admin/products
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "title": "Gratis",
  "price": 0,
  "stock": 1,
  "isActive": false
}

###

# Saves changes to the product created above. The first time gives 204. Sent again,
# it gives 409, since the stock is 2 by then and no longer the originalStock 1.
PUT {{apiUrl}}/api/admin/products/{{created.response.body.id}}
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "title": "Testprodukt, ändrad",
  "description": "Ändrad från REST Client",
  "price": 120,
  "stock": 2,
  "isActive": false,
  "originalStock": 1
}

###

# Deletes the product created above. A product that is on an order gives 409.
DELETE {{apiUrl}}/api/admin/products/{{created.response.body.id}}
Authorization: Bearer {{login.response.body.token}}

###
