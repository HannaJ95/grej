@apiUrl = http://localhost:5200

GET {{apiUrl}}/api/health
Accept: application/json

###

POST {{apiUrl}}/api/checkout
Content-Type: application/json

{
  "items": [{ "productId": 1, "quantity": 1 }]
}

###

POST {{apiUrl}}/api/checkout
Content-Type: application/json

{
  "items": [{ "productId": 1, "quantity": 1 }, { "productId": 1, "quantity": 1 }]
}

###

# REST Client asks for the email and password when sending, so they are never saved here.
# @name login
# @prompt email
# @prompt password
POST {{apiUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

###

# Send the login request above first. Its token is used here.
GET {{apiUrl}}/api/auth/me
Authorization: Bearer {{login.response.body.token}}

###

# Without a token the API answers 401.
GET {{apiUrl}}/api/auth/me

###

# The CMS's products, hidden ones too. Send the login request above first.
GET {{apiUrl}}/api/admin/products
Authorization: Bearer {{login.response.body.token}}

###

# The CMS's categories, sorted by name, at most 100 per page.
GET {{apiUrl}}/api/admin/categories
Authorization: Bearer {{login.response.body.token}}

###

# Creates a test category. The database is shared with production,
# so delete it with the last request in this file when you are done.
# @name category
POST {{apiUrl}}/api/admin/categories
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "name": "Testkategori från REST Client"
}

###

# Renames the category created above: 204.
PUT {{apiUrl}}/api/admin/categories/{{category.response.body.id}}
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "name": "Testkategori, ändrad"
}

###

# Creates a hidden test product in the test category above. The database is shared
# with production, so delete it with the DELETE request below when you are done.
# @name created
POST {{apiUrl}}/api/admin/products
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "title": "Testprodukt från REST Client",
  "description": "",
  "price": 100,
  "stock": 1,
  "isActive": false,
  "categoryId": {{category.response.body.id}}
}

###

# Price 0 breaks the rules: 400, and nothing is saved.
POST {{apiUrl}}/api/admin/products
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "title": "Gratis",
  "price": 0,
  "stock": 1,
  "isActive": false,
  "categoryId": {{category.response.body.id}}
}

###

# Saves changes to the product created above. The first time gives 204. Sent again,
# it gives 409, since the stock is 2 by then and no longer the originalStock 1.
PUT {{apiUrl}}/api/admin/products/{{created.response.body.id}}
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "title": "Testprodukt, ändrad",
  "description": "Ändrad från REST Client",
  "price": 120,
  "stock": 2,
  "isActive": false,
  "categoryId": {{category.response.body.id}},
  "originalStock": 1
}

###

# Uploads an image to the product created above, or replaces its image. Put any jpg, png or
# webp image next to this file as test-image.png (it is in .gitignore). The name does not
# matter to the API, which reads the format from the file's content.
PUT {{apiUrl}}/api/admin/products/{{created.response.body.id}}/image
Authorization: Bearer {{login.response.body.token}}
Content-Type: multipart/form-data; boundary=grej

--grej
Content-Disposition: form-data; name="altText"

En testbild från REST Client
--grej
Content-Disposition: form-data; name="file"; filename="test-image.png"
Content-Type: image/png

< ./test-image.png
--grej--

###

# Removes the image from the product above, and its file from Supabase Storage.
DELETE {{apiUrl}}/api/admin/products/{{created.response.body.id}}/image
Authorization: Bearer {{login.response.body.token}}

###

# Deletes the product created above, and its image file if it has one.
# A product that is on an order gives 409.
DELETE {{apiUrl}}/api/admin/products/{{created.response.body.id}}
Authorization: Bearer {{login.response.body.token}}

###

# Deletes the category created above. A category that has products gives 409,
# so delete the test product first.
DELETE {{apiUrl}}/api/admin/categories/{{category.response.body.id}}
Authorization: Bearer {{login.response.body.token}}

###
